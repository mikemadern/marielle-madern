# Cloudflare leest dit bestand voor de statische bestanden.
# Beveiligingsheaders. HSTS regelen we op het domein zelf (fase 8). Een Content-Security-Policy
# volgt in fase 7, omdat die getest moet worden met Adobe Fonts en de video-inbedding.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Bestanden met een hash in de naam kunnen voor altijd in de cache
/_nuxt/*
  Cache-Control: public, max-age=31536000, immutable

# Afbeeldingen hebben geen hash in de naam, dus een week
/afbeeldingen/*
  Cache-Control: public, max-age=604800

# Bestanden zonder hash in de naam. Cloudflare geeft ze anders 'max-age=0, must-revalidate', waardoor de browser ze bij
# elk bezoek opnieuw controleert.
# De video is zwaar en verandert zelden: een week. REGEL: een vervangen of bijgewerkte video krijgt altijd een nieuwe
# bestandsnaam (bijvoorbeeld met een versienummer), want onder dezelfde naam zien bezoekers die hem al hadden hoogstens
# een week lang nog de oude.
# Logo's, icoon, favicon en illustraties zijn klein en kunnen onder dezelfde naam worden vervangen: een dag.
/video/*
  Cache-Control: public, max-age=604800
/logo/*
  Cache-Control: public, max-age=86400
/illustraties/*
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400
/favicon.webp
  Cache-Control: public, max-age=86400

# Het testadres en de preview-adressen op workers.dev blijven uit zoekmachines. De regel raakt alleen hostnamen
# die eindigen op workers.dev met twee labels ervoor (bijvoorbeeld mariellemadern.account.workers.dev of
# <versie>-mariellemadern.account.workers.dev). Het eigen domein mariellemadern.nl valt er niet onder.
# Bron: Cloudflare Workers, static assets, Headers ("Prevent your workers.dev URLs showing in search results").
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
