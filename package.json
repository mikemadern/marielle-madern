{
  "name": "website",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "afbeeldingen": "node scripts/afbeeldingen.mjs",
    "dev": "pnpm afbeeldingen && pnpm bladmuziek && nuxt dev",
    "build": "pnpm generate",
    "generate": "pnpm controle && pnpm afbeeldingen && pnpm bladmuziek && pnpm test:worker && pnpm og:check && nuxt generate && pnpm controle:uitvoer",
    "preview": "wrangler dev",
    "deploy": "pnpm generate && wrangler deploy",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare",
    "controle": "node scripts/controle.mjs",
    "controle:uitvoer": "node scripts/controle-uitvoer.mjs",
    "og": "node scripts/og/maak.mjs",
    "og:check": "node scripts/og/check.mjs",
    "bladmuziek": "node scripts/bladmuziek-lijst.mjs",
    "test:worker": "node --test worker/*.test.mjs",
    "lettertype": "node scripts/lettertype.mjs"
  },
  "dependencies": {
    "@nuxt/content": "^3.17.0",
    "@nuxt/image": "^2.2.1",
    "@nuxtjs/seo": "^6.0.1",
    "nuxt": "^4.6.4",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/mukta": "5.3.0",
    "@nuxt/eslint": "^1.17.0",
    "axe-core": "^4.14.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "prettier": "^3.10.1",
    "satori": "0.63.2",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "typescript": "~6.0.3",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.165.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.5"
  }
}
